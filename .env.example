DATABASE_URL=postgresql://user:password@localhost:5432/ecomed
AUTH_SECRET=gere-um-segredo-de-autenticacao-com-pelo-menos-32-caracteres
QR_HMAC_SECRET=gere-um-segredo-exclusivo-para-qr-com-pelo-menos-32-caracteres
QR_POINT_TOKEN_TTL_SECONDS=2592000

# API pública (/api/public/v1) — opcional.
# Chaves de leitura emitidas para parceiros, ONGs e projetos acadêmicos.
# JSON em UMA linha, sem aspas externas: o --env-file do Docker não as remove
# e o JSON.parse falharia, derrubando a API pública inteira.
# "origin" libera o CORS e só importa para chamadas feitas pelo navegador —
# integrações server-to-server funcionam sem domínio registrado.
# Limite de 60 req/min por chave. Emitir: ecmd_pk_$(openssl rand -hex 24)
PUBLIC_API_KEYS={"ecmd_pk_exemplo":{"name":"Nome do parceiro","origin":"https://dominio.tld"}}
